# ============================================================================
#  Test Plan Generator (QA Agent) — Project_08
#
#  LOCAL   http://localhost:5173          <- open this one
#          http://localhost:5008          (API; the frontend proxies to it)
#
#  Two terminals:
#          npm run dev        frontend on 5173
#          npm run dev:api    API on 5008
#
#  Copy this file to .env and fill it in. .env is gitignored; production reads
#  Vercel's environment variables, not this file.
# ============================================================================

PORT=5008

# Gate for the whole API. Leave blank locally to drop the prompt. Set it on
# Vercel — the deployed API holds a Jira token and an LLM key, so every route
# behind /api is a capability worth protecting.
APP_PASSWORD=

# --- Jira Cloud ---
# Site root, no trailing slash, e.g. https://acme.atlassian.net
JIRA_BASE_URL=
# The account the API token belongs to
JIRA_EMAIL=
# Create at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=
# Default project, e.g. SCRUM
JIRA_PROJECT_KEY=
# Optional: the custom field holding acceptance criteria, if this site has one.
# Discover it in Phase 2; leave blank to scrape the description instead.
JIRA_AC_FIELD=

# --- Azure DevOps (optional) ---
# https://dev.azure.com/{organization}
ADO_ORG_URL=
ADO_PROJECT=
# Create at https://dev.azure.com/{org}/_usersSettings/tokens (Work Items: Read)
ADO_PAT=

# --- X-Ray (optional) ---
# cloud | server
XRAY_FLAVOUR=cloud
XRAY_BASE_URL=https://xray.cloud.getxray.app
XRAY_CLIENT_ID=
XRAY_CLIENT_SECRET=

# --- LLM ---
# groq | xai | openai | claude | gemini | ollama
#   groq = Groq Cloud (api.groq.com)  ·  xai = Grok (api.x.ai) — different products
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b

# https://console.groq.com/keys
GROQ_API_KEY=
# https://console.x.ai
XAI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Needs `ollama serve` running locally
OLLAMA_ENDPOINT=http://localhost:11434/api/chat
