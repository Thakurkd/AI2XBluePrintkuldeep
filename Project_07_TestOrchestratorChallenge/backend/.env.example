PORT=5007

# --- Jira Cloud ---
# Your Jira site root, no trailing slash, e.g. https://acme.atlassian.net
JIRA_BASE_URL=
# The account the API token belongs to
JIRA_EMAIL=
# Create at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=
# Default project to pull stories from, e.g. SCRUM
JIRA_PROJECT_KEY=

# --- LLM ---
# groq | openai | claude | gemini | ollama
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
# Create at https://console.groq.com/keys
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OLLAMA_ENDPOINT=http://localhost:11434/api/chat
